# Copy to frontend/.env.local if you need to override defaults.

# Base URL for API calls. Leave empty to use the Vite /api proxy (recommended,
# also makes phone testing over Wi-Fi work). Set to e.g. https://api.example.com
# for a deployed backend.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api requests.
VITE_PROXY_TARGET=http://127.0.0.1:8000
