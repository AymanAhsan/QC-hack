# Copy to backend/.env and fill in. Never commit backend/.env.

# Browser origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini: cart screenshot parsing and simulated coupons. Leave blank to use offline fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=20
MAX_UPLOAD_BYTES=5242880

# Tiger Data (Postgres + TimescaleDB). Leave blank to use local SQLite.
DATABASE_URL=
SQLITE_PATH=
# If DATABASE_URL is set but unreachable at startup, allow an explicit switch to SQLite.
ALLOW_SQLITE_FALLBACK=false
SEED_DEMO_DATA=true
